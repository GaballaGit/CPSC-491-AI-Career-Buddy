    "start": "node dist/index.js",
    "start:prod": "npm run build && npm run start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "db:check": "tsx src/database/checkConnection.ts"
  },
  "keywords": [],
